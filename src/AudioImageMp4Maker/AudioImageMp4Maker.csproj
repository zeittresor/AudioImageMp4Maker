<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AudioImageMp4Maker</AssemblyName>
    <RootNamespace>AudioImageMp4Maker</RootNamespace>
    <Version>1.0.11</Version>
    <Authors>zeittresor</Authors>
    <Company>zeittresor</Company>
    <Product>Audio Image MP4 Maker</Product>
    <Description>Creates an MP4 video from a still image and a WAV or MP3 audio file.</Description>
    <Copyright>Copyright © 2026 zeittresor</Copyright>
    <RepositoryUrl>https://github.com/zeittresor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
